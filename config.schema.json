{
  "pluginAlias": "Homebridge Bambu Plugin",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "required": ["name"],
    "additionalProperties": false,
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "Homebridge Bambu Plugin"
      },
      "printers": {
        "title": "Printers",
        "description": "Bambu printers to expose as HomeKit cameras.",
        "type": "array",
        "default": [],
        "items": {
          "type": "object",
          "required": ["name", "model", "ipAddress", "serialNumber", "lanAccessCode"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "title": "Printer Name",
              "description": "Printer name. The camera is named \"<name> Camera\" unless a camera name is set.",
              "type": "string",
              "placeholder": "Office Printer"
            },
            "model": {
              "title": "Printer Model",
              "description": "Printer model, shown in the accessory information in HomeKit.",
              "type": "string",
              "oneOf": [
                { "title": "A1", "enum": ["A1"] },
                { "title": "A1 mini", "enum": ["A1 mini"] },
                { "title": "P1P", "enum": ["P1P"] },
                { "title": "P1S", "enum": ["P1S"] },
                { "title": "P2S", "enum": ["P2S"] },
                { "title": "X1 Carbon", "enum": ["X1 Carbon"] },
                { "title": "X1E", "enum": ["X1E"] },
                { "title": "X2D", "enum": ["X2D"] },
                { "title": "H2D", "enum": ["H2D"] },
                { "title": "H2D Pro", "enum": ["H2D Pro"] },
                { "title": "H2C", "enum": ["H2C"] },
                { "title": "H2S", "enum": ["H2S"] },
                { "title": "Other Bambu Printer", "enum": ["Bambu Printer"] }
              ]
            },
            "ipAddress": {
              "title": "Printer IP Address",
              "description": "Local IP address of the printer.",
              "type": "string",
              "placeholder": "192.168.1.50"
            },
            "serialNumber": {
              "title": "Printer Serial Number",
              "description": "Printer serial number. It identifies the camera in HomeKit: changing it creates a new camera.",
              "type": "string"
            },
            "lanAccessCode": {
              "title": "LAN Access Code",
              "description": "LAN access code from the printer's network settings, used as the RTSP password.",
              "type": "string"
            },
            "cameraName": {
              "title": "Camera Accessory Name",
              "description": "Optional camera name in HomeKit.",
              "type": "string"
            },
            "cameraRtspUrl": {
              "title": "Camera Stream URL",
              "description": "Optional custom stream URL. Leave empty to use the printer's RTSPS stream on port 322.",
              "type": "string",
              "placeholder": "rtsps://bblp:lanAccessCode@192.168.1.50:322/streaming/live/1"
            },
            "ffmpegPath": {
              "title": "ffmpeg Path",
              "description": "Path to the ffmpeg binary.",
              "type": "string",
              "default": "ffmpeg"
            }
          }
        }
      }
    }
  }
}
