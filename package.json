{
  "name": "@moifort/homebridge-bambu-lab",
  "displayName": "Bambu Lab Camera",
  "type": "module",
  "version": "2.1.1",
  "private": false,
  "description": "Homebridge plugin exposing the camera of Bambu Lab printers to HomeKit, with low-latency live view.",
  "author": "Thibaut Mottet",
  "license": "Apache-2.0",
  "homepage": "https://github.com/moifort/homebridge-bambu-lab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moifort/homebridge-bambu-lab.git"
  },
  "bugs": {
    "url": "https://github.com/moifort/homebridge-bambu-lab/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "bambu",
    "bambu-lab",
    "printer",
    "camera",
    "homekit",
    "rtsp",
    "ffmpeg"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.18.0 || ^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "test": "rimraf ./.test-dist && tsc && node --test .test-dist/test/*.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "homebridge": "^2.5.0",
    "rimraf": "^6.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
