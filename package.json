{
  "name": "@moifort/homebridge-bambu-lab",
  "displayName": "Homebridge Bambu Plugin",
  "type": "module",
  "version": "2.1.0",
  "private": false,
  "description": "Homebridge plugin exposing the camera of Bambu Lab printers to HomeKit, with low-latency live view.",
  "author": "Thibaut Mottet",
  "license": "Apache-2.0",
  "homepage": "https://github.com/moifort/homebridge-bambu-lab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moifort/homebridge-bambu-lab.git"
  },
  "bugs": {
    "url": "https://github.com/moifort/homebridge-bambu-lab/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "bambu",
    "bambu-lab",
    "printer",
    "camera",
    "homekit",
    "rtsp",
    "ffmpeg"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^20.18.0 || ^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "release": "npm version patch && git push --follow-tags",
    "dev": "npm run build && npm run lint && sudo hb-service restart",
    "watch": "npm run build && npm link && nodemon"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "homebridge": "^2.0.0-beta.55",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
